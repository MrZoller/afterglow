{
  "name": "afterglow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A friendly control panel, scheduler and MCP server for Govee outdoor lights",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrZoller/afterglow.git"
  },
  "bugs": {
    "url": "https://github.com/MrZoller/afterglow/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "npm run typecheck && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:all": "npm run build && E2E_SLOW=1 playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "suncalc": "^2.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "license": "MIT"
}
