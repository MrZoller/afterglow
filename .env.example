# Your Govee API key (Govee Home app: Profile -> Settings -> Apply for API Key).
# Leave empty to run in demo mode with simulated lights.
GOVEE_API_KEY=

# Optional: an Anthropic API key turns on "Describe a look" (designs from a description).
ANTHROPIC_API_KEY=

# Port the app listens on.
PORT=4680

# Optional: require this passphrase to use the app, the API and the MCP endpoint.
# Recommended if anyone else is on your network.
ACCESS_TOKEN=

# Optional: where the daily backups are kept (default: a "backups" folder beside the data).
# Point it at a folder that syncs elsewhere, such as iCloud Drive, to survive a disk failure.
# BACKUP_DIR=

# Optional: set to 0 to stop talking to lights directly over your network and use
# Govee's cloud for everything.
# LAN=0

# Optional: where to keep saved looks, schedules and settings (default: ./data).
# DATA_DIR=

# Optional: extra hostnames this app may be opened under, comma separated.
# IP addresses and local names (localhost, *.local, *.ts.net) always work.
# ALLOWED_HOSTS=lights.example.com
